# batmGAMES Environment Variables
# Скопируй этот файл в .env и заполни значениями

# Telegram Bot (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/batmgames

# GitHub PAT (для автодеплоя, опционально)
GITHUB_TOKEN=github_pat_your_token_here

# Games Base URL
GAMES_BASE_URL=https://vnxapps.github.io/batmGAMES/games
